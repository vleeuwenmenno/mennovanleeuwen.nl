<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing the app keeps is backed up or moved to another device: not the cloud WebView's data (the
     session), not the push state, not the Keystore-wrapped secrets. A restore starts signed out. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
