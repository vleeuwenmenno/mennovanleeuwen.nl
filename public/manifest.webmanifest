{
  "name": "MvL OS",
  "short_name": "MvL OS",
  "description": "A desktop in your browser: a terminal that actually works, files, an editor, music and games. Sign in with GitHub for your own.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "fullscreen",
  "display_override": ["fullscreen", "window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0d0f14",
  "theme_color": "#0d0f14",
  "categories": ["personalization", "productivity"],
  "icons": [
    { "src": "/icons/app.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icons/app-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/app-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Terminal", "url": "/?open=terminal", "icons": [{ "src": "/icons/app-192.png", "sizes": "192x192" }] },
    { "name": "Menno's CV", "url": "/cv", "icons": [{ "src": "/icons/app-192.png", "sizes": "192x192" }] },
    { "name": "Games", "url": "/?open=games", "icons": [{ "src": "/icons/app-192.png", "sizes": "192x192" }] }
  ]
}
